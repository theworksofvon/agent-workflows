# Copy to docker.env, which Git ignores, and fill it in. compose.yaml passes
# it to the container. Do not put STATE_DIR, UI_HOST, or UI_PORT here;
# compose.yaml sets them.

AGENT=claude-code
# From `claude setup-token` on the host; it uses your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: the app acts as the accounts from
# `docker compose run --rm app gh auth login`.
# GITHUB_TOKEN=
