# Copy to .env and fill in. Every variable except GITHUB_TOKEN is optional.

# GitHub token for the `review` CLI, clones, and the app when gh has no account.
GITHUB_TOKEN=replace-me

# Agent CLI: codex or claude-code.
AGENT=codex
# CODEX_BIN=codex
# CLAUDE_CODE_BIN=claude

# Adversarial review: off, auto, or always. The agent defaults to AGENT.
# REVIEW_ADVERSARIAL_MODE=auto
# REVIEW_ADVERSARIAL_AGENT=codex

# Guided review app address.
# UI_HOST=127.0.0.1
# UI_PORT=4773

# Agent processes that run at the same time; a guided run takes 2.
# MAX_CONCURRENT_RUNS=3

# Triage engine: heuristic or systemone (the Clef sidecar).
# DECISION_ENGINE=heuristic
# DECISION_ENGINE_URL=http://127.0.0.1:8790
# DECISION_MODEL=clef-flash
# DECISION_TIMEOUT_MS=60000

# State, cached repositories, and worktrees.
# STATE_DIR=./state
# KEEP_WORKDIRS=false

# LOG_LEVEL=info
