{
  "name": "agent-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Local guided pull-request review app: agents read the PR first, you give the verdicts, and one GitHub review is published.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "start": "node --enable-source-maps dist/main.js",
    "agent-workflows": "node --enable-source-maps dist/main.js",
    "review": "node --enable-source-maps dist/main.js review",
    "ui": "node --enable-source-maps dist/main.js ui"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "octokit": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.64.0"
  }
}
